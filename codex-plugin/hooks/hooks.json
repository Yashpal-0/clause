{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex-plugin/hook.mjs\" session-start", "command_windows": "node \"%PLUGIN_ROOT%\\codex-plugin\\hook.mjs\" session-start", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex-plugin/hook.mjs\" pre", "command_windows": "node \"%PLUGIN_ROOT%\\codex-plugin\\hook.mjs\" pre", "timeout": 60 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex-plugin/hook.mjs\" post", "command_windows": "node \"%PLUGIN_ROOT%\\codex-plugin\\hook.mjs\" post", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex-plugin/hook.mjs\" settle", "command_windows": "node \"%PLUGIN_ROOT%\\codex-plugin\\hook.mjs\" settle", "timeout": 60 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$PLUGIN_ROOT/codex-plugin/hook.mjs\" prompt", "command_windows": "node \"%PLUGIN_ROOT%\\codex-plugin\\hook.mjs\" prompt", "timeout": 10 }
        ]
      }
    ]
  }
}
